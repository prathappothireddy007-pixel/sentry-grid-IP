# SentryGrid Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-this-in-production
FLASK_DEBUG=True
FLASK_PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=sentrygrid_db

# OpenWeatherMap API (Get free key at https://openweathermap.org/api)
# Leave empty to use demo mode with sample weather data
OPENWEATHER_API_KEY=

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# Polling Intervals (milliseconds) - Used by frontend JavaScript
POLL_ALERTS=30000
POLL_REQUESTS=15000
POLL_MESSAGES=5000
POLL_DASHBOARD=60000
